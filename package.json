{
  "name": "antirea",
  "version": "0.3.0",
  "description": "Lint your shipped artifacts for information leaks that reverse-engineering tools exploit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrdifferent2022/antirea.git"
  },
  "homepage": "https://github.com/Mrdifferent2022/antirea",
  "bugs": "https://github.com/Mrdifferent2022/antirea/issues",
  "type": "module",
  "bin": {
    "antirea": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "security",
    "reverse-engineering",
    "sourcemap",
    "build-hygiene",
    "lint",
    "ci"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
